@model List<HaleyMueller_Dev.Models.ProjectModel>

@foreach(var project in Model){
<div class="row" style="margin-bottom: 2em;">
    <h1 class="display-6">@project.Name</h1>
    <hr>
    <div class="row">
        <div class="col-md-9 col-sm-12 col-lg-6">
            <div id="carousel-@project.ID" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000" style="cursor:pointer;">
                <div class="carousel-inner">
                        @for (int i = 0; i < project.ImgUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">

                                <img src="@project.ImgUrls[i]"
                                     class="d-block w-100 carousel-image"
                                     onclick="openImage('@project.ImgUrls[i]')">

                            </div>
                        }
                </div>

                @if (project.ImgUrls.Any() && project.ImgUrls.Count > 1)
                {
                    <button class="carousel-control-prev"
                            type="button"
                            data-bs-target="#carousel-@project.ID"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>

                    <button class="carousel-control-next"
                            type="button"
                            data-bs-target="#carousel-@project.ID"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        </div>

        <div class="col-sm-12 col-md-3 col-lg-6 align-self-center">
            <p class="lead">
                @Html.Raw(project.Description)
            </p>
            @if (string.IsNullOrEmpty(project.Warning) == false)
            {
                <p class="text-danger">
                    @project.Warning
                </p>
            }
            <div class=""><p>Last Updated: @project.LastUpdated.ToString("d")</p></div>
            <span class="align-bottom float-start">
                    @foreach (var link in project.Links)
                    {
                        <a href="@link.Url" target="_blank">@link.Name</a>
                    }
                </span>
        </div>
    </div>
</div>
}

<div class="modal fade" id="imageModal">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close" style="z-index:1056;"></button>
            <div class="modal-body d-flex justify-content-center align-items-center p-2" onclick="closeImageModal()">
                <img id="modalImage" class="popup-image" style="max-height:90vh;">
            </div>
        </div>
    </div>
</div>

<script>

    var modal = new bootstrap.Modal(document.getElementById("imageModal"));

    function openImage(src) {
        document.getElementById("modalImage").src = src;

        modal.show();
    }

    function closeImageModal(e) {
        modal.hide();
    }


</script>